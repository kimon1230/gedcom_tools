{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/user/gedcom-tools/stats-schema.json",
  "title": "GEDCOM Stats Output",
  "description": "Schema for gedcom-tools stats command JSON output (v3 fields)",
  "type": "object",
  "properties": {
    "life_events": {
      "type": "object",
      "properties": {
        "age_at_first_marriage": {"$ref": "#/$defs/genderedAggregateStats"},
        "age_at_first_child": {"$ref": "#/$defs/genderedAggregateStats"},
        "spousal_age_gap": {"$ref": "#/$defs/aggregateStats"}
      },
      "additionalProperties": false
    },
    "family_size": {
      "oneOf": [
        {"$ref": "#/$defs/aggregateStats"},
        {"type": "null"}
      ]
    },
    "birth_patterns": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "by_month": {
              "type": "object",
              "additionalProperties": {"type": "integer", "minimum": 0}
            },
            "peak_month": {"type": "integer", "minimum": 1, "maximum": 12},
            "total": {"type": "integer", "minimum": 0}
          },
          "required": ["by_month", "peak_month", "total"],
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "lifespan_trends": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "by_century": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/aggregateStats"}
            }
          },
          "required": ["by_century"],
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "research_quality": {
      "type": "object",
      "properties": {
        "date_precision": {"$ref": "#/$defs/datePrecisionStats"},
        "occupation_coverage": {"$ref": "#/$defs/coverageStats"},
        "source_depth": {"$ref": "#/$defs/aggregateStats"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "aggregateStats": {
      "type": "object",
      "properties": {
        "average": {"type": "number"},
        "min": {"type": "integer"},
        "max": {"type": "integer"},
        "sample_size": {"type": "integer", "minimum": 0},
        "distribution": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      },
      "required": ["average", "sample_size"],
      "additionalProperties": false
    },
    "genderedAggregateStats": {
      "type": "object",
      "properties": {
        "male": {"$ref": "#/$defs/aggregateStats"},
        "female": {"$ref": "#/$defs/aggregateStats"},
        "by_century": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "male": {"$ref": "#/$defs/aggregateStats"},
              "female": {"$ref": "#/$defs/aggregateStats"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "datePrecisionStats": {
      "type": "object",
      "properties": {
        "full": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "approximate": {
          "type": "object",
          "properties": {
            "total": {"type": "integer", "minimum": 0},
            "with_full_date": {"type": "integer", "minimum": 0},
            "with_partial_date": {"type": "integer", "minimum": 0}
          },
          "required": ["total", "with_full_date", "with_partial_date"],
          "additionalProperties": false
        },
        "missing": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      },
      "required": ["full", "partial", "approximate", "missing", "total"],
      "additionalProperties": false
    },
    "coverageStats": {
      "type": "object",
      "properties": {
        "with": {"type": "integer", "minimum": 0},
        "without": {"type": "integer", "minimum": 0},
        "percent": {"type": "number", "minimum": 0, "maximum": 100}
      },
      "required": ["with", "without", "percent"],
      "additionalProperties": false
    }
  }
}
